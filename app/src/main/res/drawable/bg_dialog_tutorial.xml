<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#FAB3FB" />
            <corners android:radius="24dp" />
            <solid android:color="#EFD1B4" />
        </shape>
    </item>

    <item
        android:bottom="5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#F5F5F5" />
        </shape>
    </item>
</layer-list>