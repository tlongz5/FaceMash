<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/my_horizontal_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.0658" />

    <ImageView
        android:id="@+id/img_above"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home_above"
        app:layout_constraintDimensionRatio="412:120"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/_136sdp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_18sdp"
        android:src="@drawable/img_all_game"
        app:layout_constraintBottom_toBottomOf="@id/my_horizontal_guideline"
        app:layout_constraintDimensionRatio="150:48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/my_horizontal_guideline" />

    <ImageView
        android:id="@+id/btn_setting"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:src="@drawable/ic_setting"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintDimensionRatio="150:48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <ImageView
        android:id="@+id/btn_lip_pose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_36sdp"
        android:layout_marginTop="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:src="@drawable/img_lip_poses"
        app:layout_constraintDimensionRatio="154:152"
        app:layout_constraintEnd_toStartOf="@+id/btn_this_or_that"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_above" />

    <com.example.facemash.utils.config.GradientStrokeTextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/grandstander_extrabold"
        android:text="Lip Pose"

        app:shadowColor="#000000"
        app:shadowDy="2dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1.5dp"

        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="@+id/btn_lip_pose"
        app:layout_constraintStart_toStartOf="@+id/btn_lip_pose"
        app:layout_constraintTop_toBottomOf="@+id/btn_lip_pose"/>

    <ImageView
        android:id="@+id/btn_this_or_that"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_36sdp"
        android:src="@drawable/img_this_or_that"
        app:layout_constraintBottom_toBottomOf="@+id/btn_lip_pose"
        app:layout_constraintDimensionRatio="154:152"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_lip_pose"
        app:layout_constraintTop_toTopOf="@+id/btn_lip_pose" />

    <com.example.facemash.utils.config.GradientStrokeTextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/grandstander_extrabold"
        android:shadowColor="#000000"

        app:shadowColor="#000000"
        app:shadowDy="2dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1.5dp"
        android:text="This or That"

        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
        app:layout_constraintStart_toStartOf="@+id/btn_this_or_that"
        app:layout_constraintTop_toBottomOf="@+id/btn_lip_pose" />

    <ImageView
        android:id="@+id/btn_princess_or_witch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:src="@drawable/img_princess_or_witch"
        app:layout_constraintDimensionRatio="154:152"
        app:layout_constraintEnd_toStartOf="@id/btn_ranking"
        app:layout_constraintStart_toStartOf="@id/btn_lip_pose"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <com.example.facemash.utils.config.GradientStrokeTextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/grandstander_extrabold"
        android:textStyle="bold"

        android:text="Princess or Witch"

        app:shadowColor="#000000"
        app:shadowDy="2dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1.5dp"

        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="@+id/btn_lip_pose"
        app:layout_constraintStart_toStartOf="@+id/btn_lip_pose"
        app:layout_constraintTop_toBottomOf="@+id/btn_princess_or_witch" />

    <ImageView
        android:id="@+id/btn_ranking"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/img_ranking"
        app:layout_constraintBottom_toBottomOf="@+id/btn_princess_or_witch"
        app:layout_constraintDimensionRatio="154:152"
        app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
        app:layout_constraintStart_toEndOf="@+id/btn_princess_or_witch"
        app:layout_constraintTop_toTopOf="@+id/btn_princess_or_witch" />

    <com.example.facemash.utils.config.GradientStrokeTextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/grandstander_extrabold"
        android:shadowColor="#000000"
        android:text="Ranking"

        app:shadowColor="#000000"
        app:shadowDy="2dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1.5dp"

        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
        app:layout_constraintStart_toStartOf="@+id/btn_this_or_that"
        app:layout_constraintTop_toBottomOf="@+id/btn_ranking" />

</androidx.constraintlayout.widget.ConstraintLayout>