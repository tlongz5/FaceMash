<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    tools:context=".view.FilterFragment">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="top"
        android:layout_margin="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.example.facemash.utils.config.GradientStrokeTextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter"
        android:fontFamily="@font/grandstander_bold"
        app:shadowColor="#000000"
        app:shadowDy="2dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1dp"
        android:textColor="@color/white"
        android:textSize="@dimen/_20ssp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_20sdp">

            <ImageView
                android:id="@+id/btn_lip_pose"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:src="@drawable/img_lip_poses"
                app:layout_constraintDimensionRatio="154:152"
                app:layout_constraintEnd_toStartOf="@+id/btn_this_or_that"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.example.facemash.utils.config.GradientStrokeTextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/grandstander_extrabold"
                android:text="Lip Pose"
                app:shadowColor="#000000"
                app:shadowDy="2dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1.5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toEndOf="@+id/btn_lip_pose"
                app:layout_constraintStart_toStartOf="@+id/btn_lip_pose"
                app:layout_constraintTop_toBottomOf="@+id/btn_lip_pose"/>

            <ImageView
                android:id="@+id/btn_this_or_that"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/_36sdp"
                android:src="@drawable/img_this_or_that"
                app:layout_constraintBottom_toBottomOf="@+id/btn_lip_pose"
                app:layout_constraintDimensionRatio="154:152"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_lip_pose"
                app:layout_constraintTop_toTopOf="@+id/btn_lip_pose" />

            <com.example.facemash.utils.config.GradientStrokeTextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/grandstander_extrabold"
                app:shadowColor="#000000"
                app:shadowDy="2dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1.5dp"
                android:text="This or That"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
                app:layout_constraintStart_toStartOf="@+id/btn_this_or_that"
                app:layout_constraintTop_toBottomOf="@+id/btn_lip_pose" />

            <ImageView
                android:id="@+id/btn_princess_or_witch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:src="@drawable/img_princess_or_witch"
                app:layout_constraintDimensionRatio="154:152"
                app:layout_constraintEnd_toStartOf="@id/btn_ranking"
                app:layout_constraintStart_toStartOf="@id/btn_lip_pose"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <com.example.facemash.utils.config.GradientStrokeTextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/grandstander_extrabold"
                android:text="Princess or Witch"
                app:shadowColor="#000000"
                app:shadowDy="2dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1.5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toEndOf="@+id/btn_lip_pose"
                app:layout_constraintStart_toStartOf="@+id/btn_lip_pose"
                app:layout_constraintTop_toBottomOf="@+id/btn_princess_or_witch" />

            <ImageView
                android:id="@+id/btn_ranking"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/img_ranking"
                app:layout_constraintBottom_toBottomOf="@+id/btn_princess_or_witch"
                app:layout_constraintDimensionRatio="154:152"
                app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
                app:layout_constraintStart_toEndOf="@+id/btn_princess_or_witch"
                app:layout_constraintTop_toTopOf="@+id/btn_princess_or_witch" />

            <com.example.facemash.utils.config.GradientStrokeTextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/grandstander_extrabold"
                android:text="@string/ranking"
                app:shadowColor="#000000"
                app:shadowDy="2dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1.5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toEndOf="@+id/btn_this_or_that"
                app:layout_constraintStart_toStartOf="@+id/btn_this_or_that"
                app:layout_constraintTop_toBottomOf="@+id/btn_ranking" />

            <ImageView
                android:id="@+id/btn_hand_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:src="@drawable/img_ranking"
                app:layout_constraintDimensionRatio="154:152"
                app:layout_constraintEnd_toStartOf="@id/btn_ranking"
                app:layout_constraintStart_toStartOf="@id/btn_lip_pose"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

            <com.example.facemash.utils.config.GradientStrokeTextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/grandstander_extrabold"
                android:text="@string/hand_card"
                app:shadowColor="#000000"
                app:shadowDy="2dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1.5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toEndOf="@+id/btn_lip_pose"
                app:layout_constraintStart_toStartOf="@+id/btn_lip_pose"
                app:layout_constraintTop_toBottomOf="@+id/btn_hand_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>